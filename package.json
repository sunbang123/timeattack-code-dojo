{
  "name": "timeattack-code-dojo",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "concurrently -k -n web,api -c cyan,magenta \"corepack pnpm dev:web\" \"corepack pnpm dev:api\"",
    "dev:web": "node scripts/copy-monaco-assets.mjs && next dev --turbopack",
    "dev:api": "node scripts/run-api.mjs",
    "setup:python": "node scripts/setup-python.mjs",
    "build": "node scripts/copy-monaco-assets.mjs && next build",
    "postinstall": "node scripts/copy-monaco-assets.mjs",
    "lint": "eslint .",
    "test": "pnpm test:web && pnpm test:api && pnpm test:problems",
    "test:web": "tsc --noEmit",
    "test:api": "node scripts/test-api.mjs",
    "test:problems": "node scripts/test-problems.mjs",
    "test:problems:cpp": "node scripts/test-problems-cpp.mjs",
    "test:problems:judge0": "node scripts/test-problems-judge0.mjs",
    "check": "pnpm lint && pnpm test && pnpm build"
  },
  "dependencies": {
    "@monaco-editor/react": "4.7.0",
    "monaco-editor": "0.56.0",
    "next": "16.2.10",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "swr": "2.4.2"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.1.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "concurrently": "10.0.3",
    "eslint": "9.39.5",
    "eslint-config-next": "16.2.10",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3"
  }
}
