{
  "name": "timeattack-code-dojo",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "concurrently -k -n web,api -c cyan,magenta \"pnpm dev:web\" \"pnpm dev:api\"",
    "dev:web": "next dev --turbopack",
    "dev:api": "node scripts/run-api.mjs",
    "setup:python": "node scripts/setup-python.mjs",
    "build": "next build",
    "lint": "eslint .",
    "test": "pnpm test:web && pnpm test:api",
    "test:web": "tsc --noEmit",
    "test:api": "node scripts/test-api.mjs",
    "check": "pnpm lint && pnpm test && pnpm build"
  },
  "dependencies": {
    "next": "16.2.10",
    "react": "19.2.7",
    "react-dom": "19.2.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.1.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "concurrently": "10.0.3",
    "eslint": "9.39.5",
    "eslint-config-next": "16.2.10",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3"
  }
}
