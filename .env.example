# Step 0 provider probe configuration
# Do not commit real tokens.

# Step 1 application configuration
APP_ENV=development
API_PORT=5328
# Canonical public URL used for social preview metadata in non-Vercel hosting.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# HMAC secret for short-lived solution access grants. Development can use the
# built-in fallback; configure a long random value in every deployed environment.
SOLUTION_TOKEN_SECRET=

# PostgreSQL transaction-pooler URL. Configure this in Vercel production; when
# absent, the application falls back to the checked-in JSON problem bank.
DATABASE_URL=

# Keep public problem-bank reads warm inside a reused serverless instance while
# bounding cross-instance staleness after an author publishes a new problem.
PROBLEM_READ_CACHE_SECONDS=10

# Protect AI and manual problem creation in deployed environments. The browser
# sends this value only for an explicit creation request and does not persist it.
PROBLEM_AUTHOR_TOKEN=

# Judge0 CE: the official CE instance may work without a token. A managed or
# self-hosted instance can require X-Auth-Token.
JUDGE0_BASE_URL=https://ce.judge0.com
JUDGE0_AUTH_TOKEN=

# Piston's public API requires authorization as of 2026-02-15. Self-hosted
# instances normally do not need these authorization fields.
PISTON_BASE_URL=https://emkc.org/api/v2/piston
PISTON_TOKEN=
PISTON_AUTH_HEADER=Authorization
PISTON_AUTH_SCHEME=Bearer

# Create a Hugging Face token with the "Inference Providers" permission.
HF_TOKEN=
HF_BASE_URL=https://router.huggingface.co/v1
HF_MODEL=openai/gpt-oss-120b:groq
