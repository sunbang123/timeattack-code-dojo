{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://timeattack-code-dojo.local/schemas/private-problem.schema.json",
  "title": "Server-only problem definition",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "problem_id", "version", "pseudocode_rubric", "reference_solutions", "hidden_tests"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "problem_id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "version": {"type": "integer", "minimum": 1},
    "pseudocode_rubric": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pass_score", "criteria"],
      "properties": {
        "pass_score": {"type": "integer", "minimum": 1, "maximum": 100},
        "criteria": {
          "type": "array",
          "minItems": 3,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "description", "weight"],
            "properties": {
              "id": {"type": "string", "pattern": "^[a-z0-9_]+$"},
              "description": {"type": "string", "minLength": 1},
              "weight": {"type": "integer", "minimum": 1, "maximum": 100}
            }
          }
        }
      }
    },
    "reference_solutions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["python", "cpp"],
      "properties": {
        "python": {"type": "string", "minLength": 1},
        "cpp": {"type": "string", "minLength": 1}
      }
    },
    "hidden_tests": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "input", "expected_output"],
        "properties": {
          "name": {"type": "string", "pattern": "^[a-z0-9_]+$"},
          "input": {"type": "string"},
          "expected_output": {"type": "string"}
        }
      }
    }
  }
}

